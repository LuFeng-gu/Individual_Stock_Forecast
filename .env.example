# Audio Agent Configuration
# Copy this file to .env and fill in your values
# Each field must be specified explicitly (no automatic fallback)

# Frontend: audio-capable model (e.g., qwen3-omni-flash, gpt-4o-audio-preview)
FRONTEND_API_KEY=sk-your-frontend-key
FRONTEND_BASE_URL=https://api-2.xi-ai.cn/v1
FRONTEND_MODEL=gpt-4o-audio-preview

# Planner: text reasoning model (e.g., gpt-4o, qwen2.5)
PLANNER_API_KEY=sk-your-planner-key
PLANNER_BASE_URL=https://api-2.xi-ai.cn/v1
PLANNER_MODEL=gpt-4o

# Agent Behavior
MAX_STEPS=10
